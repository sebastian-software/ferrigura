{
  "name": "ferrigura-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm native:generate && node scripts/build-native.mjs",
    "native:generate": "node scripts/native-packages.mjs",
    "native:check": "node scripts/native-packages.mjs --check",
    "test": "node --test ferrigura/test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write -c ../tools/port/.oxfmtrc.jsonc --ignore-path=.prettierignore .",
    "format:check": "oxfmt --check -c ../tools/port/.oxfmtrc.jsonc --ignore-path=.prettierignore .",
    "lint": "node --check ferrigura/index.mjs && node --check scripts/build-native.mjs && pnpm native:check && node scripts/write-notices.mjs --check",
    "pack:check": "node scripts/verify-consumer.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.9",
    "@types/node": "26.6.6",
    "ferramenta-native": "github:sebastian-software/ferramenta#ff352075df49f56e8e0b0de8e03d43e426cba05e&path:/packages/native",
    "oxfmt": "0.75.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
