{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "component": "ferrigura",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "node/ferrigura/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "node/platforms/*/package.json",
          "glob": true,
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
