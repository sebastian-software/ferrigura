+    authorityStart += 1;
+  }
+  const rest = url.slice(authorityStart);
+  const endOffset = rest.search(/[/?#]/);
+  const authorityEnd = endOffset === -1 ? url.length : authorityStart + endOffset;
+  const authority = url.slice(authorityStart, authorityEnd);
