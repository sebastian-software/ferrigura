+const decodePercentEncodedUrlValue = (
+  value: string,
+  holder: HTMLDivElement,
+  encoder: TextEncoder
+): string =>
+  value.replace(
+    /%EF%AC%82%C2%B0(%C2%B0)?([A-Za-z0-9_]+)%C2%B6%C3%9F/g,
+    (_match, isNum: string | undefined, body: string) => {
+      const ref = isNum ? `&#${body};` : `&${body};`;
+      holder.innerHTML = `<a data-v="${ref}"></a>`;
+      const decoded = holder.firstElementChild?.getAttribute('data-v') ?? ref;
+      let out = '';
+      for (const byte of encoder.encode(decoded)) {
+        if (
+          byte <= 0x20 ||
+          byte === 0x22 ||
+          byte === 0x3c ||
+          byte === 0x3e ||
+          byte === 0x60 ||
+          byte >= 0x7f
+        ) {
+          out += `%${byte.toString(16).toUpperCase().padStart(2, '0')}`;
+        } else {
+          out += String.fromCharCode(byte);
+        }
+      }
+      return out;
+    }
+  );
