+function resolveHttpAuthorityEntities(rawUrl: string): string {
+  if (!rawUrl.includes('ﬂ°')) {
+    return rawUrl;
+  }
+  const normalized = rawUrl.replace(/\\/g, '/');
+  const schemeMatch = /^https?:/i.exec(normalized);
+  if (!schemeMatch) {
+    return rawUrl;
+  }
+  let authorityStart = schemeMatch[0].length;
+  while (authorityStart < normalized.length && normalized[authorityStart] === '/') {
+    authorityStart += 1;
+  }
+  const rest = normalized.slice(authorityStart);
+  const endOffset = rest.search(/[/?#]/);
+  const authorityEnd = endOffset === -1 ? normalized.length : authorityStart + endOffset;
+  const authority = normalized.slice(authorityStart, authorityEnd);
+  if (!authority.includes('ﬂ°')) {
+    return rawUrl;
+  }
+  const escaped = authority
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+  const decodedMarkup = decodeEntities(escaped);
+  let resolved: string;
+  if (typeof document !== 'undefined') {
+    const holder = document.createElement('div');
+    holder.innerHTML = `<a data-v="${decodedMarkup}"></a>`;
+    resolved = holder.firstElementChild?.getAttribute('data-v') ?? decodedMarkup;
+  } else {
+    resolved = decodedMarkup.replace(/&#(\+?\d+);/g, (_m, digits: string) => {
+      const cp = Number.parseInt(digits, 10);
+      return Number.isFinite(cp) && cp > 0 && cp <= 0x10ffff ? String.fromCodePoint(cp) : '\uFFFD';
+    });
+  }
+  return normalized.slice(0, authorityStart) + resolved + normalized.slice(authorityEnd);
+}
