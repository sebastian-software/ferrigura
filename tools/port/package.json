{
  "name": "ferrigura-harness",
  "private": true,
  "version": "0.0.0",
  "description": "ferrigura's harness: it checks the port against upstream Mermaid at a pinned commit (tools/reference), and holds the repository's lint and format setup",
  "type": "module",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "cd ../.. && husky tools/port/.husky",
    "pre-commit": "cd ../.. && lint-staged --config tools/port/.lintstagedrc.json",
    "lint": "tsc --noEmit -p tsconfig.json && tsx format.ts --check && cd ../.. && oxlint -c tools/port/.oxlintrc.json tools/port crates/ferrigura-node/test",
    "lint:fix": "tsx format.ts && cd ../.. && oxlint --fix -c tools/port/.oxlintrc.json tools/port crates/ferrigura-node/test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "tsx format.ts",
    "format:check": "tsx format.ts --check",
    "test": "tsx --test geometry/coverage.test.ts",
    "port:diff": "tsx diff.ts",
    "port:status": "tsx status.ts",
    "port:check-header": "tsx check-header.ts",
    "port:jsmath": "tsx jsmath-probe.ts",
    "port:text-fixture": "tsx text/chromium-fixture.ts",
    "port:text-label-fixture": "tsx text/label-fixture.ts",
    "port:cut-fonts": "tsx fonts/cut-faces.ts",
    "port:geometry-pie": "tsx geometry/pie-geometry.ts",
    "port:geometry-flowchart": "tsx geometry/flowchart-geometry.ts",
    "port:tidy-tree": "tsx geometry/tidy-tree-capture.ts",
    "port:geometry": "tsx geometry/diagram-geometry.ts",
    "port:scope-pie": "tsx geometry/pie-scope.ts",
    "port:styles-flowchart": "tsx flowchart-styles.ts",
    "port:edge-paths": "tsx export-flowchart-edges.ts",
    "port:path-bounds": "tsx path-bounds.ts",
    "port:compare-bench": "tsx compare-bench.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/ferrigura"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.62.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  }
}
