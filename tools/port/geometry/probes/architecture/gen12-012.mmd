architecture-beta
    group g1(cloud)[Group 1]
    group g2[Group 2]
    group g3(cloud)[Group 3] in g2
    service s1(server)
    service s2(server)[Service 2] in g2
    service s3(internet)[Service 3] in g1
    service s4(internet)[Service 4] in g2
    service s5(internet) in g2
    junction j1 in g2
    junction j2 in g1
    junction j3 in g3
    s4:B --> T:j2
    j3:B -- T:j2
    s4{group}:T -- R:j3
    j2:L -- R:j1
    j1:L -- T:j3
    s2:R <-- B:j3
    s5:L -[Link 9]- R:s2
    j1:L --> R:s1
    align row s4 s5
    align column s2 s4 s5
