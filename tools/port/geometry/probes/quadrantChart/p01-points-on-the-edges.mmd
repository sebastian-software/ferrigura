%% The corners and the edges of the unit square, and the coordinates written in other forms:
%% `0.0` and `0.00` read as zero, `0.12345` keeps its digits.
quadrantChart
  title Points on the edges
  x-axis Low --> High
  y-axis Low --> High
  quadrant-1 Top right
  quadrant-2 Top left
  quadrant-3 Bottom left
  quadrant-4 Bottom right
  Origin: [0, 0]
  Corner top right: [1, 1]
  Bottom right: [1, 0]
  Top left: [0, 1]
  Zero written as 0.0: [0.0, 0.00]
  Digits: [0.12345, 0.99999]
  Half: [0.5, 0.5]
