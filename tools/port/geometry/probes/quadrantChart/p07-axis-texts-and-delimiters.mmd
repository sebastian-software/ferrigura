%% Axis texts: a delimiter with no text after it appends the arrow and the DB trims it (Q8); a
%% y axis with one text puts it at the bottom (Q6, Q10); the x axis without its first text is an
%% error, so only the left texts are here.
quadrantChart
  x-axis Low -->
  y-axis Bottom --> Top
  quadrant-1 A
  quadrant-2 B
  quadrant-3 C
  quadrant-4 D
