%% Text the DB keeps as it is: an entity placeholder (`#35;` is `#`, decoded in the whole SVG),
%% an ampersand, quotes, a Markdown string and a text with an apostrophe.
quadrantChart
  title Entities & markup: "quoted" title
  x-axis Low & high --> Q#35; and more
  y-axis Bottom's --> Top
  quadrant-1 A & B
  quadrant-2 #35; hash
  quadrant-3 "Markdown" text
  quadrant-4 Plain
  Point & Q: [0.3, 0.6]
  "**Bold** label": [0.6, 0.4]
  Tab-separated	point: [0.5, 0.5]
