{
  // The TypeScript of the harness, with the tools of the crates (crates/): tsx runs it, and
  // `pnpm run typecheck` checks its types.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["DOM", "ES2024"],
    "module": "nodenext",
    "resolveJsonModule": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "vendor"]
}
