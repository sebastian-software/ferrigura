{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // The settings the repository's Prettier configuration had.
  "printWidth": 100,
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "ignorePatterns": ["vendor/**"],
}
