{
  "name": "ferrigura-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/write-site-data.mjs && ardo dev",
    "build": "node scripts/write-site-data.mjs && ardo build && node scripts/verify-build.mjs",
    "preview": "ardo preview",
    "lint": "node scripts/write-site-data.mjs && oxlint -c oxlint.config.ts && eslint . --max-warnings=0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "node scripts/write-site-data.mjs && tsc --noEmit",
    "sample:write": "node scripts/render-diagram-samples.mjs",
    "sample:check": "node scripts/render-diagram-samples.mjs --check",
    "comparison:write": "node scripts/render-comparison.mjs",
    "comparison:check": "node scripts/render-comparison.mjs --check",
    "browser:check": "node scripts/check-browser.mjs",
    "verify": "pnpm sample:check && pnpm comparison:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm browser:check"
  },
  "dependencies": {
    "ardo": "^6.4.1",
    "ferramenta-family": "github:sebastian-software/ferramenta#70d696962356af5a100c970f0f4b0187fdafcccf&path:/packages/family"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "eslint": "^10.11.0",
    "eslint-config-setup": "^0.6.0",
    "jiti": "^2.7.0",
    "oxfmt": "0.77.0",
    "oxlint": "^1.85.0",
    "playwright": "1.65.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@12.16.1"
}
