{
  "name": "mermaid",
  "version": "12.2.0",
  "description": "Markdown-ish syntax for generating flowcharts, mindmaps, sequence diagrams, class diagrams, gantt charts, git graphs and more.",
  "type": "module",
  "module": "./dist/mermaid.core.mjs",
  "types": "./dist/mermaid.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.core.mjs",
      "default": "./dist/mermaid.core.mjs"
    },
    "./*": "./*"
  },
  "keywords": [
    "diagram",
    "markdown",
    "flowchart",
    "sequence diagram",
    "gantt",
    "class diagram",
    "git graph",
    "mindmap",
    "packet diagram",
    "c4 diagram",
    "er diagram",
    "pie chart",
    "pie diagram",
    "quadrant chart",
    "requirement diagram",
    "graph",
    "eventmodeling diagram"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "types:build-config": "tsx scripts/create-types-from-json-schema.mts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid"
  },
  "author": "Knut Sveidqvist",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "standard": {
    "ignore": [
      "**/parser/*.js",
      "dist/**/*.js",
      "e2e/**/*.js"
    ],
    "globals": [
      "page"
    ]
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@iconify/utils": "^3.0.2",
    "@mermaid-js/parser": "workspace:^",
    "@types/d3": "^7.4.3",
    "@upsetjs/venn.js": "^2.0.0",
    "chevrotain": "~13.2.0",
    "cytoscape": "^3.34.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-fcose": "^2.2.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "dagre-d3-es": "7.0.14",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.12",
    "elkjs": "^0.9.3",
    "es-toolkit": "^1.45.1",
    "katex": "^0.18.0",
    "khroma": "^2.1.0",
    "marked": "^16.3.0",
    "roughjs": "^4.6.6",
    "stylis": "^4.3.6",
    "ts-dedent": "^2.2.0",
    "uuid": "^11.1.0 || ^12 || ^13 || ^14.0.0"
  },
  "devDependencies": {
    "@iconify/types": "^2.0.0",
    "@types/cytoscape": "^3.21.9",
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/jsdom": "^21.1.7",
    "@types/katex": "^0.16.8",
    "@types/stylis": "^4.2.7",
    "ajv": "^8.17.1",
    "canvas": "^3.2.3",
    "csstree-validator": "^4.0.1",
    "fastdom": "1.0.12",
    "globby": "^14.1.0",
    "jison": "^0.4.18",
    "js-base64": "^3.7.8",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "path-browserify": "^1.0.1",
    "prettier": "^3.6.2",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "start-server-and-test": "^2.1.5",
    "type-fest": "^4.41.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "~5.7.3",
    "unist-util-flatmap": "^1.0.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
