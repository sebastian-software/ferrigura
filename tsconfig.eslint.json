{
  // extend your base config to share compilerOptions, etc
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ensure that nobody can accidentally use this config for a build
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "./.build/*.ts",
    "./.esbuild/**/*.ts",
    "./.vite/*.ts",
    "./playwright.config.ts",
    "./scripts",
    "./crates/ferrigura-elk/tools",
    "./crates/ferrigura-cose/tools",
    "./crates/ferrigura-swimlane/tools",
    "./spikes",
    "./tools/port",
    "./crates/ferrigura-node/test",
    "./e2e",
    "./vite.config.ts",
    "./vitest.workspace.js",
    "eslint.config.js"
  ]
}
