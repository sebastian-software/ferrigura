{
  "name": "mermaid-monorepo",
  "private": true,
  "version": "10.2.4",
  "description": "Markdownish syntax for generating flowcharts, sequence diagrams, class diagrams, gantt charts and git graphs.",
  "type": "module",
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "node": ">=22.12.0"
  },
  "browserslist": [
    "chrome >= 121",
    "edge >= 121",
    "firefox >= 123",
    "safari >= 17.4",
    "ios_saf >= 17.4",
    "node >= 22.12"
  ],
  "keywords": [
    "diagram",
    "markdown",
    "flowchart",
    "sequence diagram",
    "gantt",
    "class diagram",
    "git graph"
  ],
  "scripts": {
    "clean": "rimraf packages/mermaid/dist",
    "build": "pnpm build:esbuild && pnpm build:types",
    "build:esbuild": "pnpm run -r clean && tsx .esbuild/build.ts",
    "build:mermaid": "pnpm build:esbuild --mermaid",
    "build:viz": "pnpm build:esbuild --visualize",
    "build:types": "pnpm --filter mermaid types:build-config && tsx .build/types.ts",
    "build:types:watch": "tsc -p ./packages/mermaid/tsconfig.json --emitDeclarationOnly --watch",
    "dev": "tsx .esbuild/server.ts",
    "copy-readme": "cpy './README.*' ./packages/mermaid/ --cwd=.",
    "lint": "eslint --quiet --stats --cache --cache-strategy content . && pnpm lint:jison && prettier --cache --check .",
    "lint:fix": "eslint --cache --cache-strategy content --fix . && prettier --write . && tsx scripts/fixCSpell.ts",
    "lint:jison": "tsx ./scripts/jison/lint.mts",
    "ci": "vitest run",
    "test": "pnpm lint && vitest run",
    "test:watch": "vitest --watch",
    "test:watch:em": "vitest --watch packages/parser/tests/eventmodeling.test.ts",
    "test:check:tsc": "tsx scripts/tsc-check.ts",
    "port:diff": "tsx tools/port/diff.ts",
    "port:status": "tsx tools/port/status.ts",
    "port:check-header": "tsx tools/port/check-header.ts",
    "port:jsmath": "tsx tools/port/jsmath-probe.ts",
    "port:text-fixture": "tsx tools/port/text/chromium-fixture.ts",
    "port:text-label-fixture": "tsx tools/port/text/label-fixture.ts",
    "port:cut-fonts": "tsx tools/port/fonts/cut-faces.ts",
    "port:geometry-pie": "tsx tools/port/geometry/pie-geometry.ts",
    "port:geometry-flowchart": "tsx tools/port/geometry/flowchart-geometry.ts",
    "port:tidy-tree": "tsx tools/port/geometry/tidy-tree-capture.ts",
    "port:geometry": "tsx tools/port/geometry/diagram-geometry.ts",
    "port:scope-pie": "tsx tools/port/geometry/pie-scope.ts",
    "port:styles-flowchart": "tsx tools/port/flowchart-styles.ts",
    "port:edge-paths": "tsx tools/port/export-flowchart-edges.ts",
    "prepare": "husky && pnpm build",
    "pre-commit": "lint-staged",
    "port:path-bounds": "tsx tools/port/path-bounds.ts",
    "port:compare-bench": "tsx tools/port/compare-bench.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mermaid-js/mermaid"
  },
  "author": "Knut Sveidqvist",
  "license": "MIT",
  "standard": {
    "ignore": [
      "**/parser/*.js",
      "dist/**/*.js",
      "e2e/**/*.js"
    ],
    "globals": [
      "page"
    ]
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@cspell/eslint-plugin": "^9.3.2",
    "@eslint/js": "^9.26.0",
    "@lezer/highlight": "^1.2.3",
    "@rollup/plugin-typescript": "^12.1.4",
    "@shoelace-style/shoelace": "^2.20.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.24",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.21",
    "@vitest/spy": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "ajv": "^8.17.1",
    "chokidar": "3.6.0",
    "codemirror-lang-mermaid": "^0.5.0",
    "concurrently": "^9.2.4",
    "cors": "^2.8.6",
    "cpy-cli": "^5.0.0",
    "cspell": "^9.3.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.26.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-jsdoc": "^61.1.12",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-lodash": "^8.0.0",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "express": "^5.2.1",
    "globals": "^16.4.0",
    "globby": "^14.1.0",
    "husky": "^9.1.7",
    "jison": "^0.4.18",
    "js-yaml": "^4.3.0",
    "jsdom": "^26.1.0",
    "langium-cli": "~4.4.0",
    "lint-staged": "^16.1.6",
    "lit": "^3.3.3",
    "path-browserify": "^1.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-jsdoc": "^1.3.3",
    "rimraf": "^6.0.1",
    "start-server-and-test": "^2.1.5",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "dependency-tree": "11.4.3",
      "@isaacs/brace-expansion": "^5.0.1",
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "dompurify": "3.4.12",
      "js-yaml@<3.15.0": "3.15.0",
      "minimatch@10": "^10.2.6"
    },
    "patchedDependencies": {
      "fastdom": "patches/fastdom.patch",
      "roughjs": "patches/roughjs.patch"
    },
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "vue-demi"
    ]
  }
}
