{
  // The TypeScript of the harness (tools/port), of the tools of the crates and of the Node addon's
  // tests: tsx runs it, and the typed lint checks it through tsconfig.eslint.json.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["DOM", "ES2024"],
    "module": "nodenext",
    "resolveJsonModule": true,
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": ["**/node_modules/*", "target", ".git"]
}
